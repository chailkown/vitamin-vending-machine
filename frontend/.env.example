# Use the same project as health-app-web; public/publishable key only.
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# Production catalog must not silently use sample inventory.
REACT_APP_USE_SAMPLE_FALLBACK=false
# Actual free dispensing is served by Pi gateway at localhost:3000.
# The browser does not hold a device credential or call privileged order RPCs.
