{
  "name": "health-app-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:integration": "node --test tests/integration.mjs",
    "dev": "vite --port 3001",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "android:init": "npm install @capacitor/core @capacitor/cli @capacitor/android --save-dev && npx cap add android",
